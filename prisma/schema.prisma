generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement())
  uid        String  @default(uuid())
  fullName  String
  email     String   @unique
  password  String   // Only store the actual password
  gender    String
  dob       DateTime
  createdAt DateTime @default(now())
}
